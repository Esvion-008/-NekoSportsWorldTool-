<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.esvim.tool" android:versionCode="20503" android:versionName="0.2.5-android.3">
    <!-- applicationId 沿用改名前的历史值：保持同一 app id，老用户才能覆盖安装、不丢数据。
         JNI 符号（Java_org_esvim_tool_*）与之一一对应，不要单独改。 -->
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 自更新：把已下载的新版 APK 交给系统安装器（用户在系统弹窗确认） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <application android:label="格陵兰岛" android:allowBackup="false"
        android:hasCode="true" android:extractNativeLibs="true" android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar" android:icon="@drawable/app_icon">
        <activity android:name=".MainActivity" android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|screenLayout|uiMode|density"
            android:windowSoftInputMode="adjustResize" android:screenOrientation="portrait">
            <meta-data android:name="android.app.lib_name" android:value="greenland" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 自更新安装器读取私有目录里的 update.apk（只读、仅授权该 URI） -->
        <provider android:name=".ApkProvider" android:authorities="org.esvim.tool.apk"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
